PORT=3005
# Obligatorio, mínimo 32 caracteres. Generalo con: openssl rand -hex 32
# (el backend no arranca si queda vacío o con un valor de ejemplo)
JWT_SECRET=

DB_HOST=localhost
DB_USER=heimdall
DB_PASSWORD=your_strong_password_here
DB_NAME=heimdall_db

CORS_ORIGIN=http://localhost:5180
NODE_ENV=development

# Contraseña inicial de la cuenta "admin", solo en el primer arranque (tabla de usuarios vacía).
# Si queda vacía se genera una aleatoria y se muestra una vez en el log. El primer ingreso obliga
# a cambiarla.
# ADMIN_PASSWORD_INICIAL=

# Registro de eventos para el SIEM (Wazuh). Ver integraciones/wazuh/LEEME.md
# HEIMDALL_EVENT_LOG=off            # ruta del archivo, u "off" para apagarlo (por defecto backend/logs/eventos.json)
# HEIMDALL_EVENT_LOG_MAX_MB=50
# HEIMDALL_EVENT_LOG_KEEP=5
# HEIMDALL_SENSOR=heimdall-dmz      # nombre del sensor (por defecto, el del servidor)
